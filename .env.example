# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.
#
# The app works fully without these — if GEMINI_API_KEY is unset (or the
# API call fails for any reason), analysis automatically falls back to the
# deterministic extraction engine (lib/extraction.ts).

# Server-side only. Never exposed to the browser. Get one at
# https://aistudio.google.com/apikey (Gemini API free tier).
GEMINI_API_KEY=

# Optional. Defaults to "gemini-3.6-flash" if unset.
GEMINI_MODEL=
